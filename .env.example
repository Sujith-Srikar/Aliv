# Copy to .env and fill in values from your Supabase project Dashboard -> Settings -> API

# Browser-safe (Astro client + anon role). Safe to expose.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER shipped to the browser. Used by Astro API routes for CRUD.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal secret/token shared between pg_cron and the check-monitors Edge Function.
# Any non-empty string that a cron job can pass as a bearer token.
WORKER_SECRET=some-long-random-secret

# Supabase CLI linking (local only, not read by the app):
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your-db-password
